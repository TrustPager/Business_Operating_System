# Local working directory for in-progress ports. Sweep runs here BEFORE
# anything gets promoted to the repo root.
_staging/

# Secrets and credentials — must never be committed.
*.env
.env
.env.*
*.key
*.pem
*-keys.json
*api-keys.json
*credentials.json
bos.json
bos-journal/

# Local sweep reports (may contain sensitive matches mid-investigation).
_scripts/sweep-report-*.txt
_scripts/*.log

# OS / editor / tooling
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
*.swp
*~

# Python build artefacts (for the sweep script and any helpers)
__pycache__/
*.pyc
*.pyo
.pytest_cache/
venv/
.venv/

# Node — in case any installer wraps in npm
node_modules/
package-lock.json
yarn.lock

# Next.js build output.
.next/
out/

# Webdev capability — held back from the public repo for now (2026-07-07).
# Kept locally to slot back in later; untracked with `git rm --cached`, not deleted.
skills/design-my-site/
skills/launch-my-site/
templates/site-starter/
docs/architecture/2026-07-03-site-builder-design.md
docs/architecture/plans/2026-07-03-site-builder.md
drivers/vercel/
knowledge/web-design-method.md
tests/test_inline_design_system.py
tests/test_vercel_driver.py

# Studio render outputs (PNGs from `npm run shoot`; each owner renders their
# own, never committed). The studios' own file-maps document this.
studio/*/output/

# Vite dev-server dependency cache (regenerated on demand; never committed).
studio/*/.vite/

# Local install state
.tp/
~/

# Graphify knowledge-graph build artefacts
graphify-out/

# Git worktrees (isolated build workspaces)
.worktrees/

# Firecrawl scratch (research-run cache, not a deliverable)
.firecrawl/

# Dogfood throwaway profile (tools/dogfood.py)
.dogfood/

# Your brand kit is YOURS. The live brand files are seeded from brand/defaults/
# on setup and are never tracked, so updating (git pull) never collides with your
# branding. brand-my-workspace writes to these; brand/defaults/ stays the neutral
# blank-canvas fallback.
brand/brand.json
brand/logo.png
brand/icon.png
brand/favicon-16x16.png
brand/favicon-32x32.png
brand/favicon-192x192.png
brand/favicon-512x512.png
brand/favicon.ico

# Local Claude Code state (session data, agent worktrees) — never commit.
.claude/

# Evelyn Weiss's source skill doc, kept locally as reference material only.
Meta Ads Skill template.md
