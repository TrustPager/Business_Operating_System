{
  "name": "trustpager-youtube-thumbnails",
  "version": "1.0.0",
  "description": "Code-driven YouTube thumbnail studio on the owner's brand, for any kind of video. Browser editor at localhost:3210, headless PNG export at 1280x720.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preview": "vite preview",
    "make": "node scripts/make.js",
    "shoot": "node scripts/shoot.js",
    "shoot:all": "node scripts/shoot.js",
    "publish": "node scripts/publish.js",
    "publish:all": "node scripts/publish.js --all",
    "render": "node scripts/render.js",
    "render:all": "node scripts/render.js --all",
    "coverage": "node scripts/coverage.js",
    "build": "vite build"
  },
  "dependencies": {
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "puppeteer": "^24.8.0",
    "vite": "^6.3.5"
  }
}
